{
  "name": "create-stern-config",
  "version": "1.0.3",
  "description": "CLI tool to setup ESLint and Prettier configuration for Stern projects",
  "type": "module",
  "bin": {
    "create-stern-config": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts --outfile ./dist/cli.js --target node --format esm",
    "dev": "bun run src/cli.ts",
    "prepublishOnly": "bun run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "eslint",
    "prettier",
    "cli",
    "setup",
    "stern",
    "bun"
  ],
  "author": "stern <contact@stern.bio>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xstern/create-stern-config.git"
  },
  "engines": {
    "node": ">=23.11.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/bun": "latest",
    "@types/node": "^22.10.5",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^60.7.1",
    "eslint-plugin-n": "^17.23.1",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.45.0"
  }
}
